package auth

import "muttley/templates"

templ Signup(page Page) {
	<!DOCTYPE html>
	<html>
		@templates.Head() {
			<link rel="stylesheet" type="text/css" href="/styles/auth.css"/>
		}
		<body>
			<div id="auth-page">
				<div class="auth-card">
					<div class="auth-card-title"><span>Create Account</span></div>
					if page.Error != nil {
						<div id="auth-error">
							<div id="auth-error-title">
								<span>{ page.Error.Type }</span>
							</div>
							<div id="auth-error-message">
								<span>{ page.Error.Message }</span>
							</div>
						</div>
					}
					if page.SentEmail != "" {
						<div id="auth-form">
							<div class="auth-success">
								<div class="auth-success-title">Check your email</div>
								<div class="auth-success-message">We sent a link to { page.SentEmail } to create your account. It expires in 15 minutes and can only be used once.</div>
							</div>
						</div>
						<div class="auth-links">
							Wrong email? <a href="/signup">Try again</a>
						</div>
					} else {
						<p class="auth-note">We'll email you a link to create your account. You can add your name after you sign in.</p>
						<form id="auth-form" action="/signup" method="POST">
							<div class="auth-field">
								<label for="email">Email</label>
								<input id="email" type="email" name="email" value={ page.Email } required/>
							</div>
							<input class="auth-submit" type="submit" value="Email me a sign-up link"/>
						</form>
						<div class="auth-links">
							Already have an account? <a href="/login">Log in</a>
						</div>
					}
				</div>
			</div>
		</body>
	</html>
}

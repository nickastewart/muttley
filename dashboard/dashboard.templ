package dashboard 

import "muttley/templates"

templ Dashboard() {
	@templates.Head()
	@templates.Header()
	<div class="main-container">
		<div class="dashboard">
			<div class="dashboard-top-row dashboard-row dashboard-row-flex">
				<div class="dashboard-top-row-item dashboard-top-row-item-half-flex">
					<div class="dashboard-top-row-item-title"><span>Races</span></div>
					<div class="dashboard-top-row-item-content"><span>10</span></div>
				</div>
				<div class="dashboard-top-row-item dashboard-top-row-item-one-flex">
					<div class="dashboard-top-row-item-title"><span>Wins</span></div>
					<div class="dashboard-top-row-item-content"><span><sup>1</sup>/<sub>10</sub></span> <span class="dashboard-top-row-item-percentage">10%</span></div>
				</div>
				<div class="dashboard-top-row-item dashboard-top-row-item-one-flex">
					<div class="dashboard-top-row-item-title"><span>Podiums</span></div>
					<div class="dashboard-top-row-item-content"><span><sup>4</sup>/<sub>10</sub></span> <span class="dashboard-top-row-item-percentage">40%</span></div>
				</div>
				<div class="dashboard-top-row-item dashboard-top-row-item-one-flex">
					<div class="dashboard-top-row-item-title "><span>Best Place</span></div>
					<div class="dashboard-top-row-item-content"><span>5<sup style="font-size:0.5em">th</sup></span></div>
				</div>
				<div class="dashboard-top-row-item dashboard-top-row-item-one-flex">
					<div class="dashboard-top-row-item-title"><span>Average Place</span></div>
					<div class="dashboard-top-row-item-content"><span>10<sup style="font-size:0.5em">th</sup></span></div>
				</div>
				<div class="dashboard-top-row-item dashboard-top-row-item-one-flex">
					<div class="dashboard-top-row-item-title"><span>Head To Head Wins</span></div>
					<div class="dashboard-top-row-item-content"><span>1</span></div>
				</div>
				<div class="dashboard-top-row-item dashboard-top-row-item-one-flex" style="margin-right:0;">
					<div class="dashboard-top-row-item-title"><span>Best Track</span></div>
					<div class="dashboard-top-row-item-content dashboard-top-row-item-content-best-track">Daytona Milton Keynes</div>
				</div>
			</div>
			<div class="dashboard-row dashboard-row-flex">
				<div id="dashboard-track-count-bar-chart-container" class="dashboard-top-row-item-one-flex">
					<canvas id="dashboard-track-count-bar-chart" width="600" height="200"></canvas>
				</div>
				<div id="dashboard-position-line-chart-container" class="dashboard-top-row-item-one-flex">
					<canvas id="dashboard-line-chart" width="600" height="200"></canvas>
				</div>
			</div>
			<div class="dashboard-list dashboard-row">
				<table id="dashboard-table">
					<thead>
						<th class="dashboard-header-cell">Date</th>
						<th class="dashboard-header-cell">Location</th>
						<th class="dashboard-header-cell">Event Type</th>
						<th class="dashboard-header-cell">Best Lap Time</th>
						<th class="dashboard-header-cell">Average Lap Time</th>
						<th class="dashboard-header-cell">Position</th>
						<th class="dashboard-header-cell">Number Of Laps</th>
					</thead>
					<tbody>
						<tr class="dashboard-row">
							<td class="dashboard-cell">20th Sep 2026</td>
							<td class="dashboard-cell">Daytona Milton Keynes</td>
							<td class="dashboard-cell">2025 SODI 40 Race</td>
							<td class="dashboard-cell">01:20.741</td>
							<td class="dashboard-cell">01:24.667</td>
							<td class="dashboard-cell">17th</td>
							<td class="dashboard-cell">14</td>
						</tr>
						<tr class="dashboard-row">
							<td class="dashboard-cell">20th Sep 2026</td>
							<td class="dashboard-cell">Daytona Milton Keynes</td>
							<td class="dashboard-cell">2025 SODI 40 Race</td>
							<td class="dashboard-cell">01:20.741</td>
							<td class="dashboard-cell">01:24.667</td>
							<td class="dashboard-cell">17th</td>
							<td class="dashboard-cell">14</td>
						</tr>
						<tr class="dashboard-row">
							<td class="dashboard-cell">20th Sep 2026</td>
							<td class="dashboard-cell">Daytona Milton Keynes</td>
							<td class="dashboard-cell">2025 SODI 40 Race</td>
							<td class="dashboard-cell">01:20.741</td>
							<td class="dashboard-cell">01:24.667</td>
							<td class="dashboard-cell">17th</td>
							<td class="dashboard-cell">14</td>
						</tr>
						<tr class="dashboard-row">
							<td class="dashboard-cell">20th Sep 2026</td>
							<td class="dashboard-cell">Daytona Milton Keynes</td>
							<td class="dashboard-cell">2025 SODI 40 Race</td>
							<td class="dashboard-cell">01:20.741</td>
							<td class="dashboard-cell">01:24.667</td>
							<td class="dashboard-cell">17th</td>
							<td class="dashboard-cell">14</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>
	<script>
        const trackChart = document.getElementById('dashboard-track-count-bar-chart');

        document.addEventListener('DOMContentLoaded',function() {
            new Chart(trackChart, {
                type: 'bar',
                data: {
                    labels: ['Daytona Milton Keynes', 'Daytona Sandown Park'],
                    datasets: [{
                        data: [5, 4],
                        backgroundColor: '#3b82f6',
                        borderColor: '#2563eb',
                        borderWidth: 0,
                        borderRadius: 6,
                        barThickness: 45
                    }]
                },
                options: {
                    indexAxis:'y',
                    responsive: false,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false,
                        },
                        title: {
                            display: false
                        }
                    },
                    scales: {
                        x: {
                            display: false,
                            grid: { display: false },
                        },
                        y: {
                            grid: { display: false },
                            border: { display: false }
                        }
                    }
                },
            });

            const ctx = document.getElementById('dashboard-line-chart');
                
             new Chart(ctx, {
                type: 'line',
                data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'],
                datasets: [{
                    data: [17, 10, 13, 15, 18, 6, 8],
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 3,
                    tension: 0.4,           // Smooth curve
                    pointRadius: 5,
                    pointHoverRadius: 7,
                    pointBackgroundColor: '#fff',
                    pointBorderWidth: 2
                }]
                },
                options: {
                    responsive: false,        // Important for fixed size
                    maintainAspectRatio: false,
                    
                    plugins: {
                        legend: { display: false},
                    },
                     tooltip: {
                        callbacks: {
                            title: function() {
                            return '';        // Removes the X-axis label (Jan, Feb, etc.)
                            }
                        }
                    },
                    scales: {
                        x: { 
                            display: false,           // X axis hidden
                            grid: { display: false },
                            ticks: { display: false}

                        },
                        y: { 
                            reverse: true,
                            border: { display: false },   // Y axis line removed
                            grid: { display: false },
                        }
                    }
                },
            });
        });

    </script>
}

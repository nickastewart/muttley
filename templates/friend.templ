package templates

import (
	"fmt"
	"muttley/sqlite/entities"
)

templ Friend(friends []entities.GetFriendsByUserRow) {
	@Head() {
		<link rel="stylesheet" type="text/css" href="/styles/friends.css"/>
	}
	@Header()
	<div class="main-container">
		<div id="friend-container">
			<div id="friend-actions">
				<input
					hx-get="/search/friends"
					hx-target="#friend-list"
					hx-trigger="keyup changed delay:500ms"
					type="search"
					id="friends-search-input"
					name="searchTerm"
					placeholder="Search..."
					minlength="3"
					maxlength="20"
				/>
			</div>
			<div id="friend-list">
				for _, friend := range friends {
					<div class="friend-card">
						<div class="friend-card-info">
							<div class="friend-card-title">{ friend.DisplayName }</div>
							<div class="friend-card-subtitle">{ friend.FirstName + " " + friend.LastName }</div>
						</div>
						<div class="friend-card-actions">
							if friend.FriendStatus == "ACCEPTED" || friend.FriendStatus == "REQUESTED" {
								<button class="friend-card-button" hx-post={ fmt.Sprintf("/remove-friend?profileId=%s", friend.ProfileID) }>Remove</button>
							} else if friend.ConfirmationRequired == "true" {
								<button class="friend-card-button">Accept</button>
							}
						</div>
					</div>
				}
			</div>
		</div>
	</div>
}

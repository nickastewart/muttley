package templates

import "muttley/sqlite/entities"

templ FriendSearchResults(users []entities.GetUsersBySearchTermRow) {
	for _, user := range users {
		<div class="friend-card">
			<h3>{ user.FirstName + " " + user.LastName }</h3>
			if user.FriendStatus == "ACCEPTED" {
				<button disabled>Accepted</button>
			} else if user.FriendStatus == "REQUEST_PENDING" {
				<button>Pending Request</button>
			} else {
				<button>Add</button>
			}
		</div>
	}
}

package templates

templ UploadFile() {
	@Head() {
		<link rel="stylesheet" type="text/css" href="/styles/upload.css"/>
	}
	@Header()
	<div class="main-container">
		<div id="upload-file-container">
			<div class="upload-file-card">
				<div class="upload-file-card-title"><span>Upload Result</span></div>
				<form id="upload-file-form" method="post" action="/upload/process" enctype="multipart/form-data">
					<div class="upload-file-field">
						<label for="file-location">Track</label>
						<select id="file-location" name="file-location">
							<option value="Daytona Milton Keynes">Daytona Milton Keynes</option>
							<option value="Daytona Sandown Park">Daytona Sandown Park</option>
						</select>
					</div>
					<div class="upload-file-field">
						<label for="upload-file-input">Results file</label>
						<input id="upload-file-input" type="file" name="file" accept=".eml"/>
					</div>
					<input id="file-upload-submit" value="Submit" type="submit"/>
				</form>
			</div>
		</div>
	</div>
}
